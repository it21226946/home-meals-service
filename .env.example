# MongoDB (Atlas or local). Example Atlas:
# DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/home-meals?retryWrites=true&w=majority
DATABASE_URL=

# Secret for JWT tokens (use a long random string)
JWT_KEY=

# Server port (optional, default 3000)
PORT=3000

# Cloudinary — optional for API startup; required when uploading images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
